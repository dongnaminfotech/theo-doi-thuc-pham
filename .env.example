# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newgreen_db?schema=public"

# App & Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"

# Auth (luôn thay bằng giá trị ngẫu nhiên mạnh khi triển khai)
AUTH_SECRET="dev-auth-secret-change-in-production-min-32-chars-long"
ADMIN_EMAIL="admin@newgreen.edu.vn"
ADMIN_NAME="Quản trị viên Hệ thống"
ADMIN_PASSWORD="change-this-admin-password"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage (S3-compatible)
STORAGE_DRIVER="local" # "local" | "s3"
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_BUCKET="newgreen-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
